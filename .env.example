# Environment variables for rust-monitor

# Discord webhook URL (required)
MONITOR_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Discord message ID to patch (required)
MONITOR_MESSAGE_ID=your_message_id

# SSH key path for remote server access (optional, default: ~/.ssh/id_ed25519)
MONITOR_SSH_KEY_PATH=/home/user/.ssh/id_ed25519

# Remote server hostname or IP (optional, default: 127.0.0.1)
MONITOR_REMOTE_HOST=192.168.1.100

# Remote server SSH user (optional, default: root)
MONITOR_REMOTE_USER=root

# Update interval in seconds (optional, default: 30)
MONITOR_INTERVAL_SECS=30

# Display names for the embed fields (optional)
MONITOR_LOCAL_NAME=🏠 Local Server
MONITOR_REMOTE_NAME=☁️ Remote Server
